  "item": [
    {
      "name": "Cross-country: NYC to LA",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "route", ""],
          "query": [
            {"key": "start", "value": "New York, NY"},
            {"key": "finish", "value": "Los Angeles, CA"}
          ]
        }
      }
    },
